    <Entry Name="DetectSettings">ENG MOS SOZLAMALARNI TOPISH</Entry>
    <Entry Name="DetectSettingsPrompt">HOZIRGI SOZLAMALAR OʻCHIB KETADI. DAVOM ETASIZMI?</Entry>
    <Entry Name="Resolution">Ekran oʻlchami</Entry>
    <Entry Name="Resolution_Info">Ekran oʻlchamini oʻzgartiradi. Toʻliq ekran rejimida monitorning oʻz oʻlchamini tanlash tavsiya etiladi.[br][br]Videokartaga yuk beradi.</Entry>
    <Entry Name="ResolutionScale">Tasvir aniqligi</Entry>
    <Entry Name="ResolutionScale_Info">Uch oʻlchamli sahnaning aniqligini interfeysga nisbatan oʻzgartiradi. Oʻz oʻlchamingizda oʻyin sekinlashsa, buni pasaytiring.[br][br]Videokartaga yuk beradi.</Entry>
    <Entry Name="DynamicResolution">Moslashuvchan aniqlik</Entry>
    <Entry Name="DynamicResolution_Info">Kadr tezligi tushib ketsa, aniqlikni oʻzi pasaytiradi.[br][br]Videokarta ishini ancha yengillashtiradi.</Entry>
    <Entry Name="DisplayMode">Ekran rejimi</Entry>
    <Entry Name="DisplayMode_Info">Oʻyin oynasi qanday koʻrsatilishini belgilaydi.[br][br]Toʻliq ekran: butun ekranni egallaydi.[br]Oynali: alohida oynada koʻrsatiladi.[br]Ramkasiz: ramkasiz oynada koʻrsatiladi.</Entry>
    <Entry Name="Fullscreen">Toʻliq ekran</Entry>
    <Entry Name="Windowed">Oynali</Entry>
    <Entry Name="Borderless">Ramkasiz</Entry>
    <Entry Name="VSync">Vertikal sinxronlash</Entry>
    <Entry Name="VSync_Info">Tasvirning yirtilishini yoʻqotadi, ammo kechikish paydo boʻlishi mumkin.</Entry>
    <Entry Name="Adaptive">Moslashuvchan</Entry>
    <Entry Name="UpdateRate">Kadr tezligi</Entry>
    <Entry Name="UpdateRate_Info">Oʻyin ushlab turishga harakat qiladigan kadr tezligi. Pasaytirsangiz, ish barqarorroq boʻladi.</Entry>
    <Entry Name="AllowSlowdowns">Silliq kadr tezligi</Entry>
    <Entry Name="AllowSlowdowns_Info">Unum tushib ketsa, oʻyin yetib olish uchun oʻzini sekinlashtiradi.</Entry>
    <Entry Name="FOV">Koʻrish burchagi</Entry>
    <Entry Name="FOV_Info">Gorizontal koʻrish burchagini sozlaydi.[br][br]Protsessorga yuk beradi.</Entry>
    <Entry Name="AA">Silliqlash</Entry>
    <Entry Name="AA_Info">Tasvirdagi tishli chiziqlar va oʻtkir piksel qirralarini yoʻqotadi.[br][br]Videokartaga ozgina yuk beradi.</Entry>
    <Entry Name="FXAA">FXAA</Entry>
    <Entry Name="TextureQuality">Tekstura sifati</Entry>
    <Entry Name="TextureQuality_Info">Oʻyindagi teksturalar qanchalik aniq boʻlishini belgilaydi.[br][br]Video xotiraga katta yuk beradi.</Entry>
    <Entry Name="TextureFiltering">Tekstura filtri</Entry>
    <Entry Name="TextureFiltering_Info">Teksturalarni oʻqish usuli.[br][br]Bilinear: eng past sifat.[br]Trilinear: oʻrtacha sifat.[br]AF: eng yuqori sifat.[br][br]Videokartaga yuk beradi.</Entry>
    <Entry Name="Bilinear">BILINEAR</Entry>
    <Entry Name="Trilinear">TRILINEAR</Entry>
    <Entry Name="Anis2x">AFx2</Entry>
    <Entry Name="Anis4x">AFx4</Entry>
    <Entry Name="Anis8x">AFx8</Entry>
    <Entry Name="Anis16x">AFx16</Entry>
    <Entry Name="TextureStreaming">Tekstura oqimi</Entry>
    <Entry Name="TextureStreaming_Info">Oʻyinchiga yaqin teksturalar yuqori sifatli, uzoqdagilari past sifatli boʻladi.[br][br]Protsessor, videokarta va video xotiraga yuk beradi.</Entry>
    <Entry Name="ShadowQuality">Soya sifati</Entry>
    <Entry Name="ShadowQuality_Info">Oʻyindagi soyalar qanchalik aniq boʻlishini belgilaydi.[br][br]Protsessor, videokarta va video xotiraga yuk beradi.</Entry>
    <Entry Name="DirShadowQuality">Quyosh soyasi sifati</Entry>
    <Entry Name="DirShadowQuality_Info">Quyoshdan tushadigan soyalar qanchalik aniq boʻlishini belgilaydi.[br][br]Protsessor, videokarta va video xotiraga yuk beradi.</Entry>
    <Entry Name="LanternShadows">Fonar soyalari</Entry>
    <Entry Name="LanternShadows_Info">Fonar soya tushirishiga ruxsat beradi.[br][br]Protsessor va videokartaga yuk beradi.</Entry>
    <Entry Name="Reflection">Aks etish</Entry>
    <Entry Name="Reflection_Info">Suv yuzasida atrofni aks ettiradi.[br][br]Oʻchiq: aks etish yoʻq.[br]Statik: harakatdagi buyumlarsiz aks etish, tezroq ishlaydi.[br]Dinamik: toʻliq aks etish, eng ogʻiri.</Entry>
    <Entry Name="Static">STATIK</Entry>
    <Entry Name="Dynamic">DINAMIK</Entry>
    <Entry Name="Refraction">Nur sinishi</Entry>
    <Entry Name="Refraction_Info">Shisha va suyuqlikdan oʻtayotgan nurni sindiradi.[br][br]Videokartaga yuk beradi.</Entry>
    <Entry Name="SkinShading">Teri soyalanishi</Entry>
    <Entry Name="SkinShading_Info">Odam va maxluqlarning terisini haqqoniy koʻrsatadi.[br][br]Videokartaga katta yuk beradi.</Entry>
    <Entry Name="TerrainQuality">Yer sathi sifati</Entry>
    <Entry Name="TerrainQuality_Info">Yer sathining teksturasi va geometriyasi qanchalik aniq boʻlishini belgilaydi.[br][br]Videokartaga yuk beradi.</Entry>
    <Entry Name="DepthOfField">Chuqurlik keskinligi</Entry>
    <Entry Name="DepthOfField_Info">Kamera yaqinga qaraganda uzoqdagi buyumlar qanchalik xiralashishini belgilaydi.[br][br]Videokartaga katta yuk beradi.</Entry>
    <Entry Name="SSAO">SSAO</Entry>
    <Entry Name="SSAO_Info">Bir-biriga yaqin buyumlar orasida soya chizadi.[br][br]Videokartaga yuk beradi.</Entry>
    <Entry Name="SoftParticles">Silliq zarrachalar</Entry>
    <Entry Name="SoftParticles_Info">Zarrachalar fonga tegib turgan joydagi keskin qirralarni yoʻqotadi.[br][br]Videokartaga katta yuk beradi.</Entry>
    <Entry Name="ParticleQuality">Zarracha sifati</Entry>
    <Entry Name="ParticleQuality_Info">Olov va gaz kabi zarrachalarning aniqlik darajasini belgilaydi.[br][br]Protsessor va videokartaga yuk beradi.</Entry>
    <Entry Name="ReduceCameraMotion">Kamera tebranishini kamaytirish</Entry>
    <Entry Name="ReduceCameraMotion_Info">Koʻngil aynishiga sabab boʻladigan kamera tebranishini kamaytiradi.</Entry>
    <Entry Name="Bloom">Nur taralishi</Entry>
    <Entry Name="Bloom_Info">Ekranning yorugʻ joylari atrofida shuʼla chizadi.[br][br]Videokartaga yuk beradi.</Entry>
    <Entry Name="Blur">Xiralik</Entry>
    <Entry Name="Blur_Info">Xiralik yoqilganda ekran qanchalik xiralashishini belgilaydi.[br][br]Videokartaga katta yuk beradi.</Entry>
    <Entry Name="FilmGrain">Plyonka donadorligi</Entry>
    <Entry Name="FilmGrain_Info">Tasvirga eskirgan plyonka taʼsirini beradigan yengil donadorlik qoʻshadi.[br][br]Videokartaga ozgina yuk beradi.</Entry>
    <Entry Name="Volume">Tovush balandligi</Entry>
    <Entry Name="Volume_Info">Musiqa va tovush effektlarining balandligi.</Entry>
    <Entry Name="VolumeMaster">Umumiy tovush</Entry>
    <Entry Name="VolumeMaster_Info">Barcha tovushlarning balandligi</Entry>
    <Entry Name="VolumeMusic">Musiqa</Entry>
    <Entry Name="VolumeMusic_Info">Musiqa balandligi</Entry>
    <Entry Name="VolumeSound">Tovush effektlari</Entry>
    <Entry Name="VolumeSound_Info">Tovush effektlarining balandligi.</Entry>
    <Entry Name="VolumeDialog">Nutq</Entry>
    <Entry Name="VolumeDialog_Info">Suhbatlarning balandligi.</Entry>
    <Entry Name="Subtitles">Subtitrlar</Entry>
    <Entry Name="Subtitles_Info">Ekranning pastida subtitr koʻrsatadi.</Entry>
    <Entry Name="SubtitleOptions">SUBTITR SOZLAMALARI</Entry>
    <Entry Name="HearingAid">Tovush izohlari</Entry>
    <Entry Name="HearingAid_Info">Eshitilishi qiyin boʻlgan tovushlar haqida yozuv chiqaradi.</Entry>
    <Entry Name="AnimateSubtitles">Harflab chiqarish</Entry>
    <Entry Name="AnimateSubtitles_Info">Subtitr matnini harfma-harf chiqaradi.</Entry>
    <Entry Name="FadeSubtitlesOverDistance">Masofaga qarab soʻnish</Entry>
    <Entry Name="FadeSubtitlesOverDistance_Info">Uzoqdagi tovushlarning subtitrini xiralashtiradi.</Entry>
