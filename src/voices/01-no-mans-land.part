  <CATEGORY Name="Voices_no_mans_land">
    <Entry Name="comments_dialogue_frienddrinkswater_001_augustinlambert_001">... Henri...?</Entry>
    <Entry Name="comments_dialogue_frienddrinkswater_002_augustinlambert_001">Senmisan?</Entry>
    <Entry Name="comments_dialogue_frienddrinkswater_003_henriclement_001">Mana, buni ich. Keyin seni bu yerdan olib chiqaman.</Entry>
    <Entry Name="comments_dialogue_friendprecarried_001_augustinlambert_001">Yurolmayman... Oyogʻim... madorim yoʻq...</Entry>
    <Entry Name="comments_dialogue_friendprecarried_002_henriclement_001">Seni tinch joyga olib boraman, menga mahkam yopish.</Entry>
    <Entry Name="comments_dialogue_germansoldiersnoticeplayer_001_germansoldiers_001">SCHNELL! SCHNELL!</Entry>
    <Entry Name="comments_dialogue_germansoldiersnoticeplayer_002_germansoldiers_001">Da drüben! Da drüben!</Entry>
    <Entry Name="comments_dialogue_germansoldiersnoticeplayer_003_germansoldiers_001">Nach rechts!</Entry>
    <Entry Name="comments_dialogue_germansoldiersnoticeplayer_004_germansoldiers_001">Erschießt sie!</Entry>
    <Entry Name="comments_dialogue_germansoldiersnoticeplayer_005_germansoldiers_001">Dort! Dort!</Entry>
    <Entry Name="comments_dialogue_germansoldiersnoticeplayer_006_germansoldiers_001">Er rennt!</Entry>
    <Entry Name="comments_dialogue_germansoldiersnoticeplayer_007_germansoldiers_001">Lasst ihn nicht entkommen</Entry>
    <Entry Name="comments_dialogue_germansoldiersnoticeplayer_008_germansoldiers_001">In Deckung gehen!</Entry>
    <Entry Name="comments_dialogue_friendreacttogermans_001_augustinlambert_001">Henri, ular bizni topib qolishdi.</Entry>
    <Entry Name="comments_dialogue_friendreacttogermans_002_augustinlambert_001">Men senga yuk boʻlyapman. Meni tashlab ket.</Entry>
  </CATEGORY>
