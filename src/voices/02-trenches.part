  <CATEGORY Name="Voices_trenches">
    <Entry Name="comments_dialogue_takecover_001_augustinlambert_001">Henri! Panaga oʻt! Tez! Tez!</Entry>
    <Entry Name="comments_dialogue_takecover_002_augustinlambert_001">Xandaq boʻylab yur! U seni uchrashuv joyiga olib boradi.</Entry>
    <Entry Name="comments_dialogue_germansoldiersambushed_001_germansoldier_1_001">Noch Einer! Noch Einer! Hinter uns!!!</Entry>
    <Entry Name="comments_dialogue_germansoldiersambushed_002_germansoldier_1_001">Nein!</Entry>
    <Entry Name="comments_dialogue_germansoldiersambushed_003_germansoldier_2_001">Französischer Hund!</Entry>
    <Entry Name="comments_dialogue_germansoldiersattack_intro_001_germansoldier_1_001">DORT! DORT!</Entry>
    <Entry Name="comments_dialogue_germansoldiersattack_intro_002_germansoldier_1_001">Feuer!</Entry>
    <Entry Name="comments_dialogue_germansoldiersattack_takingcover_001_germansoldier_1_001">Er ist in Deckung gegangen.</Entry>
    <Entry Name="comments_dialogue_germansoldiersattack_grenade_001_germansoldier_1_001">Werft eine Granate!</Entry>
    <Entry Name="comments_dialogue_germansoldiersattack_spotplayer_001_germansoldier_2_001">Da is er!</Entry>
    <Entry Name="comments_dialogue_germansoldiersattack_spotplayer_002_germansoldier_2_001">Hol ihn dir.</Entry>
    <Entry Name="comments_dialogue_germansoldiersattack_playerhiding_001_germansoldier_2_001">Kann nicht auf ihn schießen!</Entry>
    <Entry Name="comments_dialogue_germansoldiersattack_playerhiding_002_germansoldier_2_001">Kann sich nicht ewig verstecken!</Entry>
    <Entry Name="comments_dialogue_friendpostambushpushforward_001_augustinlambert_001">Yoʻl ochiq, Henri.</Entry>
    <Entry Name="comments_dialogue_friendpostambushpushforward_002_augustinlambert_001">Men shu yerdan seni qoʻriqlab turaman. Sen oldinga yuraver.</Entry>
    <Entry Name="comments_dialogue_friendsavesplayer_001_augustinlambert_001">Buni kiy, tez, tez.</Entry>
    <Entry Name="comments_dialogue_friendsavesplayer_002_augustinlambert_001">Balli. Bugun oʻlmaysan, doʻstim — oʻlim dangasalarning yoʻli. Endi ortimdan yur. Yetib qoldik.</Entry>
    <Entry Name="comments_dialogue_friendsavesplayer_alt_001_augustinlambert_001">Buni tez kiy, tez! Meni tashlab ketma, Henri. Bu doʻzaxdan birga chiqamiz.</Entry>
    <Entry Name="comments_dialogue_friendsavesplayer_alt_002_augustinlambert_001">Endi ortimdan yur, yetib qoldik.</Entry>
    <Entry Name="comments_dialogue_friendgaswarning_001_augustinlambert_001">GAZ!</Entry>
    <Entry Name="comments_dialogue_friendlookingforplayer_001_augustinlambert_001">Henri! Qayerdasan?! HENRI!</Entry>
    <Entry Name="comments_dialogue_dicegame_001_augustinlambert_001">Ha ha! Bundan oshirib tashla-chi, doʻstim!</Entry>
    <Entry Name="comments_dialogue_dicegame_002_henriclement_001">Mana, koʻrdingmi.</Entry>
    <Entry Name="comments_dialogue_dicegame_003_augustinlambert_001">Eh! Taqdir degani harom ekan! Demak, bugun kechqurun patrulga men chiqaman. C&apos;est la vie.</Entry>
    <Entry Name="comments_dialogue_dicegame_alt_001_henriclement_001">Bugun kuning emas, doʻstim.</Entry>
    <Entry Name="comments_dialogue_warcries_english_001_frenchsoldiers_001">Ot! Ot!</Entry>
    <Entry Name="comments_dialogue_warcries_english_002_frenchsoldiers_001">Ana u yerda!</Entry>
    <Entry Name="comments_dialogue_warcries_english_003_frenchsoldiers_001">Panaga!</Entry>
    <Entry Name="comments_dialogue_warcries_english_004_frenchsoldiers_001">Oʻngga!</Entry>
    <Entry Name="comments_dialogue_warcries_english_005_frenchsoldiers_001">CHEKINAMIZ!</Entry>
    <Entry Name="comments_dialogue_warcries_english_006_frenchsoldiers_001">Otishni toʻxtatmang!</Entry>
    <Entry Name="comments_dialogue_warcries_english_007_frenchsoldiers_001">Oldinga! Oldinga!</Entry>
    <Entry Name="comments_dialogue_warcries_english_008_frenchsoldiers_001">Granata!</Entry>
    <Entry Name="comments_dialogue_warcries_english_009_frenchsoldiers_001">Hech nima koʻrmayapman!</Entry>
    <Entry Name="comments_dialogue_warcries_english_010_frenchsoldiers_001">Laʼnat! Laʼnat!</Entry>
  </CATEGORY>
