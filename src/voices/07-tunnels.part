<CATEGORY Name="Voices_tunnels">
    <Entry Name="comments_dialogue_poem_001_toussaintbeaufoy_001">Dunyoni aylantiramiz, aylantiramiz dunyoni...</Entry>
    <Entry Name="comments_dialogue_poem_002_toussaintbeaufoy_001">Bari dahshatli girdobda yoʻqolar...</Entry>
    <Entry Name="comments_dialogue_poem_003_toussaintbeaufoy_001">Quyoshni koʻrmayman — qora tutun qalin...</Entry>
    <Entry Name="comments_dialogue_poem_004_toussaintbeaufoy_001">Yerni koʻrmayman — oʻliklar bosgan...</Entry>
    <Entry Name="comments_dialogue_poem_005_toussaintbeaufoy_001">Dengizni koʻrmayman, daraxtni koʻrmayman...</Entry>
    <Entry Name="comments_dialogue_poem_006_toussaintbeaufoy_001">Shu bois tiz choʻkib shu yerda qolaman...</Entry>
    <Entry Name="comments_dialogue_poem_007_toussaintbeaufoy_001">Kuylayman, kuylayman...</Entry>
    <Entry Name="comments_dialogue_poem_008_toussaintbeaufoy_001">Dunyoni aylantiramiz, aylantiramiz dunyoni...</Entry>
    <Entry Name="comments_dialogue_poem_009_toussaintbeaufoy_001">Bari yoʻqolar, koʻr qiladigan girdobda yoʻqolar...</Entry>
    <Entry Name="comments_dialogue_poem_010_toussaintbeaufoy_001">Zulmatdagi bir irillash...</Entry>
    <Entry Name="comments_dialogue_poem_011_toussaintbeaufoy_001">Bogʻdagi bir gʻamgin kun...</Entry>
    <Entry Name="comments_dialogue_poem_012_toussaintbeaufoy_001">Toshga oʻyilgan esdalik...</Entry>
    <Entry Name="comments_dialogue_poem_013_toussaintbeaufoy_001">Otning kir koʻzpanasi...</Entry>
    <Entry Name="comments_dialogue_poem_014_toussaintbeaufoy_001">Bolaning boʻsh kafti...</Entry>
    <Entry Name="comments_dialogue_poem_015_toussaintbeaufoy_001">Doʻstning dogʻ boʻlgan qoʻlbogʻi...</Entry>
    <Entry Name="comments_dialogue_poem_016_toussaintbeaufoy_001">Rastada hamon turgan kunlik xabar...</Entry>
    <Entry Name="comments_dialogue_poem_017_toussaintbeaufoy_001">Kuylayman, kuylayman...</Entry>
    <Entry Name="comments_dialogue_poem_018_toussaintbeaufoy_001">Dunyoni aylantiramiz, aylantiramiz dunyoni...</Entry>
    <Entry Name="comments_dialogue_poem_019_toussaintbeaufoy_001">Bari yoʻqolar, qonli girdobda yoʻqolar...</Entry>
    <Entry Name="comments_dialogue_poem_020_toussaintbeaufoy_001">Burilishdan keyin nima chiqar?</Entry>
    <Entry Name="comments_dialogue_poem_021_toussaintbeaufoy_001">Balki qandaydir bir tugash boʻlar...</Entry>
    <Entry Name="comments_dialogue_poem_022_toussaintbeaufoy_001">Ehtimolrogʻi — yana bir hushtak...</Entry>
    <Entry Name="comments_dialogue_poem_023_toussaintbeaufoy_001">Sehr! Odamni goʻshtga aylantirgan sehr.</Entry>
    <Entry Name="comments_dialogue_poem_024_toussaintbeaufoy_001">Kuylashdan boshqa nima qoʻlimizdan kelar...</Entry>
    <Entry Name="comments_dialogue_poem_025_toussaintbeaufoy_001">Dunyoni aylantiramiz, aylantiramiz dunyoni...</Entry>
    <Entry Name="comments_dialogue_poem_026_toussaintbeaufoy_001">Bari yoʻqolar, biz esa hamon aylanamiz.</Entry>
