  <CATEGORY Name="Inventory">
    <Entry Name="Medkit">Dori qutisi</Entry>
    <Entry Name="Medkit_Desc">Jang maydonida yaralanganda ishlatiladi. Toʻgʻri ishlatilsa, eng ogʻir yaradorni ham oyoqqa turgʻizadi.</Entry>
    <Entry Name="Medkit_AltDesc">Jang maydonida yaralanganda ishlatiladi. Qonni toʻxtatadi va sogʻliqni toʻliq tiklaydi.</Entry>
    <Entry Name="Bandage">Bint</Entry>
    <Entry Name="Bandage_Desc">Kichik yaralar uchun. Toʻliq tuzatmasa ham, askarni oyoqqa turgʻizishga yetadi.</Entry>
    <Entry Name="Bandage_AltDesc">Qonni toʻxtatadi, ammo sogʻliqni tiklamaydi.</Entry>
    <Entry Name="LockdownWheel">Qamal gʻildiragi</Entry>
    <Entry Name="LockdownWheel_Desc">Favqulodda qamal darvozalarini ochish va yopish uchun.</Entry>
    <Entry Name="DetonatorHandle">Portlatgich tutqichi</Entry>
    <Entry Name="DetonatorHandle_Desc">Dinamit va portlatgich bilan birga ishlatiladi.</Entry>
    <Entry Name="MolotovCocktail">Benzin shishasi</Entry>
    <Entry Name="MolotovCocktail_Desc">Qoʻlbola oʻt ochuvchi qurol. Tegishi bilan sinadi va yonadi.</Entry>
    <Entry Name="EmptyMolotovCocktail">Lattali boʻsh shisha</Entry>
    <Entry Name="EmptyMolotovCocktail_Desc">Ogʻziga latta tiqilgan shisha. Uloqtirsa boʻladi.</Entry>
    <Entry Name="FuelBottle">Yoqilgʻili shisha</Entry>
    <Entry Name="FuelBottle_Desc">Yoqilgʻiga toʻldirilgan shisha. Uloqtirsa boʻladi.</Entry>
    <Entry Name="ClothPiece">Latta</Entry>
    <Entry Name="ClothPiece_Desc">Bir vaqtlar harbiy kiyim boʻlgan, endi latta.</Entry>
    <Entry Name="Cutters">Simqirqar</Entry>
    <Entry Name="Cutters_Desc">Jang maydonidagi toʻsiqlarni olib tashlash uchun. Zanjir, sim va boshqa ingichka temirni qirqadi.</Entry>
    <Entry Name="Wrench">Gayka kaliti</Entry>
    <Entry Name="Wrench_Desc">Gʻildirakli gayka kaliti — maʼlum turdagi vintlarni burab chiqaradi.</Entry>
    <Entry Name="SaveRoomKey">Kalit</Entry>
    <Entry Name="SaveRoomKey_Desc">Kalit.</Entry>
    <Entry Name="Lighter">Chaqmoqtosh</Entry>
    <Entry Name="Lighter_Desc">Xira yorugʻlik beradi, olov yoqishga yaraydi.</Entry>
    <Entry Name="Flare">Yoritgich</Entry>
    <Entry Name="Flare_Desc">Yordam kerak boʻlganda ishlatiladi. Yorqin yonib, qattiq shivirlab belgi beradi. Uloqtirsa boʻladi.</Entry>
    <Entry Name="GasMask">Gaz niqobi</Entry>
    <Entry Name="GasMask_Desc">Gaz hujumida oʻpka va koʻzni saqlaydi. Kiyilganda yon tomonni koʻrish va eshitish susayadi.</Entry>
    <Entry Name="GasGrenade">Gaz granatasi</Entry>
    <Entry Name="GasGrenade_Desc">Gaz granatasi. Uloqtirilgandan bir necha soniya keyin zaharli gaz purkaydi.</Entry>
    <Entry Name="Grenade">Granata</Entry>
    <Entry Name="Grenade_Desc">Granata. Chekkasi tortilgach, bir necha soniyada portlaydi.</Entry>
    <Entry Name="EmptyBottle">Boʻsh shisha</Entry>
    <Entry Name="EmptyBottle_Desc">Boʻsh shisha. Uloqtirsa boʻladi.</Entry>
    <Entry Name="PocketWatch">Choʻntak soati</Entry>
    <Entry Name="PocketWatch_Desc">Sekundomerli choʻntak soati. Generatorga moslab qoʻyilsa, yoqilgʻi qancha qolganini oʻlchab turadi.</Entry>
    <Entry Name="Dynamite">Dinamit</Entry>
    <Entry Name="Dynamite_Desc">Portlatish kerak boʻlganda ishlatiladi — vaqti kelib kerak ham boʻladi. Portlatgich talab qilinadi.</Entry>
    <Entry Name="DynamiteBundle">Dinamit bogʻlami</Entry>
    <Entry Name="DynamiteBundle_Desc">Portlatish kerak boʻlganda ishlatiladi — vaqti kelib kerak ham boʻladi. Portlatgich talab qilinadi.</Entry>
    <Entry Name="PocketBag">Xaltacha</Entry>
    <Entry Name="PocketBag_Desc">Bu xaltacha bilan koʻproq narsa koʻtarasiz.</Entry>
    <Entry Name="Fuel">Yoqilgʻi</Entry>
    <Entry Name="Fuel_Desc">Benzin. Tez yonadi. Generator uchun. Boʻsh shishaga quysa yoki yerga toʻksa boʻladi.</Entry>
    <Entry Name="Gun">Revolver</Entry>
    <Entry Name="Gun_Desc">Oddiy xizmat quroli. Barabanida olti uya bor.</Entry>
    <Entry Name="Shotgun">Miltiq</Entry>
    <Entry Name="Shotgun_Desc">12-kalibrli pompali miltiq. Magaziniga 6 ta patron, bittasi stvolda. Xandaqdagi yaqin jang uchun.</Entry>
    <Entry Name="DynamoLantern">Fonar</Entry>
    <Entry Name="DynamoLantern_Desc">Qoʻlda buraladigan fonar. Yorugʻligi yetarli, ammo tez-tez burab turish kerak.</Entry>
    <Entry Name="Stick">Tayoq</Entry>
    <Entry Name="Stick_Desc">Yogʻoch boʻlagi.</Entry>
    <Entry Name="Torch">Mashʼala</Entry>
    <Entry Name="Torch_Desc">Boshqa iloj qolmaganda oddiy mashʼala zulmatni yoritadi; silkitilsa, mayda kemiruvchi va yirtqichlarni haydaydi.</Entry>
    <Entry Name="Meat">Goʻsht</Entry>
    <Entry Name="Meat_Desc">Aynigan goʻshtni askar yemasligi kerak. Kalamush va bunkerdagi boshqa zararkunandalarni chaqirish uchun asqotadi. Uloqtirsa boʻladi.</Entry>
    <Entry Name="RabbitDoll">Quyoncha</Entry>
    <Entry Name="RabbitDoll_Desc">Paxta bilan toʻldirilgan quyon oʻyinchoq. Kimgadir qadrli boʻlsa kerak. Uloqtirsa boʻladi.</Entry>
    <Entry Name="CommunicationsKey">Aloqa xonasi kaliti</Entry>
    <Entry Name="CommunicationsKey_Desc">Aloqa xonasi eshigi uchun.</Entry>
    <Entry Name="PillboxKey">Dzot kaliti</Entry>
    <Entry Name="PillboxKey_Desc">Dzot eshigi uchun.</Entry>
    <Entry Name="MeatSilencer">Qoʻlbola tovushqaytargich</Entry>
    <Entry Name="MeatSilencer_Desc">Revolverga oʻrnatiladi. Bir marta otganda tovushni sezilarli pasaytiradi.</Entry>
    <Entry Name="Ammunition">Revolver oʻqlari</Entry>
    <Entry Name="Ammunition_Desc">Revolver uchun 8 mm patronlar. Qurolni qoʻlga olib, $Input{CheckAmmo} ni bosib turib $Input{Interact} ni bosing.</Entry>
    <Entry Name="ShotgunAmmunition">Miltiq patronlari</Entry>
    <Entry Name="ShotgunAmmunition_Desc">12-kalibrli soqmali miltiq patronlari. Qurolni qoʻlga olib, $Input{CheckAmmo} ni bosib turib $Input{Interact} ni bosing.</Entry>
    <Entry Name="Fuse">Saqlagich</Entry>
    <Entry Name="Fuse_Desc">Tokni ulash uchun saqlagich qalqoniga oʻrnatiladi.</Entry>
    <Entry Name="Note">Qayd</Entry>
    <Entry Name="Photo">Surat</Entry>
    <Entry Name="DogTag">Askar jetoni</Entry>
  </CATEGORY>
