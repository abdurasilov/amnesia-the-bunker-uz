  <CATEGORY Name="BunkerTest">
    <Entry Name="IntroText">
			"Bu urushda tirik qolish uchun senga ikki narsa kerak: birinchisi — oddiy koʻnikmalar. Ikkinchisi — kerak boʻlsa hamma narsaga qoʻl uradigan aql.[br][br]Birinchisini men oʻrgataman. Ikkinchisi oʻzingdan."[br][br] - Romain Delpy, brigada generali, Uchinchi respublikaning 4-armiyasi
		</Entry>
  </CATEGORY>
  <CATEGORY Name="GUIText">
    <Entry Name="IntroMessageText">Endi yolgʻizsiz. Oʻrganing, moslashing, sinab koʻring va tirik qoling.</Entry>
  </CATEGORY>
