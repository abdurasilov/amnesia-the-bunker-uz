    <Entry Name="PressToStart">Davom etish uchun istalgan tugmani bosing...</Entry>
    <Entry Name="PressToStart_PS4">Davom etish uchun istalgan tugmani bosing...</Entry>
    <Entry Name="PressToStart_XBO">Davom etish uchun istalgan tugmani bosing...</Entry>
